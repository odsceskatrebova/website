            <field-name>id</field-name>
            <entity-name>App\Entity\Lead</entity-name>
        </property>

        <property name="createdAt" visibility="always" searchability="yes" translation="app.createdAt">
            <field-name>createdAt</field-name>
            <entity-name>App\Entity\Lead</entity-name>
        </property>

        <property name="name" visibility="yes" translation="app.name">
            <field-name>name</field-name>
