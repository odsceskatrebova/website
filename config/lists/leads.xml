        <property name="email" visibility="yes" translation="app.email">
            <field-name>email</field-name>
            <entity-name>App\Entity\Lead</entity-name>
        </property>

        <property name="phone" visibility="yes" translation="app.phone">
            <field-name>phone</field-name>
            <entity-name>App\Entity\Lead</entity-name>
        </property>

        <property name="source" visibility="yes" translation="app.source">
