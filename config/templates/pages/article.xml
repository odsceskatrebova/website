<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article</key>

    <view>pages/article</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title lang="en">Article</title>
        <title lang="de">Artikel</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="route" mandatory="true">
            <meta>
                <title lang="en">Resourcelocator</title>
                <title lang="de">Adresse</title>
            </meta>

            <tag name="sulu.rlp"/>
        </property>

        <section name="openGraph">
            <meta>
                <title lang="en">Open graph</title>
            </meta>
            <properties>
                <property name="ogImage" type="single_media_selection" colspan="6">
                    <meta><title lang="en">OG image</title></meta>
                </property>
            </properties>
        </section>

        <property name="displayTitle" type="text_line">
            <meta>
                <title lang="en">Display title</title>
            </meta>
        </property>

        <property name="heroHeader" type="checkbox" colspan="3">
            <meta><title lang="en">Hero header</title></meta>
        </property>

        <property name="darkHeroBackground" type="checkbox" colspan="3">
            <meta>
                <title lang="en">Dark hero background</title>
                <info_text lang="en">Makes header text white</info_text>
            </meta>
        </property>

        <property name="image" type="single_media_selection">
            <meta>
                <title lang="en">Image</title>
                <title lang="de">Bild</title>
            </meta>
        </property>

        <property name="perex" type="text_area">
            <meta>
                <title lang="en">Perex</title>
                <title lang="de">Einleitung</title>
            </meta>
        </property>

        <property name="article" type="text_editor">
            <meta>
                <title lang="en">Article</title>
                <title lang="de">Artikel</title>
            </meta>
        </property>

        <block name="content" default-type="text-block">
            <meta>
                <title lang="en">Content</title>
                <title lang="de">Inhalt</title>
            </meta>
            <params>
                <param name="add_button_text">
                    <meta>
                        <title lang="en">Add content</title>
                    </meta>
                </param>
                <param name="block_id_generator" value="true"/>
            </params>
            <types>
                <type ref="text-block" />
                <type ref="image-block" />
                <type ref="icon-block" />
                <type ref="grid-block" />
                <type ref="background-block" />
                <type ref="content-snippet-block" />
                <type ref="flex-block" />
                <type ref="button-block" />
                <type ref="video-block" />
                <type ref="scrollable-video-block" />
                <type ref="card-block" />
                <type ref="carousel-gallery-block" />
                <type ref="divider-block" />
                <type ref="empty-block" />
                <type ref="form-block" />
                <type ref="generic-header-block" />
                <type ref="masonry-gallery-block" />
                <type ref="newsletter-subscribe-block" />
                <type ref="timeline-block" />
            </types>
        </block>
    </properties>
</template>
