<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>timeline-block</key>

    <meta>
        <title lang="en">Timeline</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="3">
            <meta>
                <title lang="en">sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="3">
            <meta><title lang="en">id</title></meta>
        </property>
        <property name="classes" type="text_line" colspan="6">
            <meta><title lang="en">classes</title></meta>
        </property>

        <block name="events" default-type="event-block">
            <meta>
                <title lang="en">Events</title>
            </meta>
            <params>
                <param name="add_button_text">
                    <meta>
                        <title lang="en">Add event</title>
                    </meta>
                </param>
                <param name="block_id_generator" value="true"/>
            </params>
            <types>
                <type name="event-block">
                    <meta>
                        <title lang="en">event</title>
                    </meta>
                    <properties>
                        <property name="year" type="text_line" colspan="4">
                            <tag name="sulu.block_preview" priority="1024"/>
                            <meta><title lang="en">year</title></meta>
                        </property>
                        <property name="text" type="text_editor">
                            <meta><title lang="en">text</title></meta>
                            <tag name="sulu.block_preview" priority="512"/>
                        </property>
                        <property name="image" type="single_media_selection" colspan="4">
                            <meta>
                                <title lang="en">image</title>
                            </meta>
                            <tag name="sulu.block_preview" priority="256"/>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>

</template>
