<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>content-snippet-block</key>

    <meta>
        <title lang="en">Content snippet</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="3">
            <meta>
                <title lang="en">sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="3">
            <meta><title lang="en">id</title></meta>
        </property>
        <property name="classes" type="text_line" colspan="6">
            <meta><title lang="en">classes</title></meta>
        </property>

        <property name="contentSnippet" type="single_snippet_selection" colspan="12">
            <meta><title lang="en">content snippet</title></meta>
            <params>
                <param name="types" value="content"/>
                <param name="loadExcerpt" value="true"/>
            </params>
        </property>
    </properties>

</template>
