<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>text-block</key>

    <meta>
        <title lang="en">Text</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="3">
            <meta>
                <title lang="en">sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="3">
            <meta>
                <title lang="en">id</title>
            </meta>
        </property>
        <property name="classes" type="text_line" colspan="6">
            <meta><title lang="en">classes</title></meta>
        </property>
        <property name="text" type="text_editor">
            <meta><title lang="en">text</title></meta>
            <tag name="sulu.block_preview" priority="1024"/>
            <tag name="sulu.search.field" />
        </property>
        <property name="noPaddings" type="checkbox" colspan="4">
            <meta><title lang="en">no text paddings</title></meta>
            <params>
                <param name="type" value="toggler"/>
            </params>
        </property>
        <property name="theme" type="single_select" colspan="4">
            <meta><title lang="en">Text theme</title></meta>
            <params>
                <param name="default_value" value="auto"/>
                <param name="values" type="collection">
                    <param name="auto"><meta><title lang="en">Auto (inherit)</title></meta></param>
                    <param name="dark-section"><meta><title lang="en">On dark (white text)</title></meta></param>
                    <param name="light-section"><meta><title lang="en">On light (dark text)</title></meta></param>
                </param>
            </params>
        </property>
    </properties>

</template>
