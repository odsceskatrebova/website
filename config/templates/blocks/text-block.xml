<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>text-block</key>

    <meta>
        <title lang="en">Text</title>
    </meta>

    <properties>
        <property name="text" type="text_editor">
            <meta><title lang="en">text</title></meta>
            <tag name="sulu.block_preview" priority="1024"/>
            <tag name="sulu.search.field" />
        </property>
        <property name="classes" type="text_line" colspan="8">
            <meta><title lang="en">classes</title></meta>
        </property>
        <property name="noPaddings" type="checkbox" colspan="4">
            <meta><title lang="en">no text paddings</title></meta>
            <params>
                <param name="type" value="toggler"/>
            </params>
        </property>
    </properties>

</template>
