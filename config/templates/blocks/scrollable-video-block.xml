<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>scrollable-video-block</key>

    <meta>
        <title lang="en">Scrollable video block</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="6">
            <meta>
                <title lang="en">Sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="6">
            <meta><title lang="en">id</title></meta>
        </property>

        <property name="backgroundVideo" type="single_media_selection" colspan="6">
            <meta><title lang="en">Background video (mobile)</title></meta>
        </property>
        <property name="backgroundVideoTablet" type="single_media_selection" colspan="6">
            <meta><title lang="en">Background video (tablet+)</title></meta>
        </property>

        <property name="animationLength" type="number" colspan="4">
            <meta>
                <title lang="en">Animation length in seconds</title>
                <info_text lang="en">Animation runs when video appears above bottom edge of display and finishes when video touches top edge</info_text>
            </meta>
            <params>
                <param name="min" value="0"/>
                <param name="max" value="100"/>
            </params>
        </property>

        <property name="hero" type="checkbox" colspan="2">
            <meta><title lang="en">Hero mode</title></meta>
        </property>

        <property name="debug" type="checkbox" colspan="2">
            <meta><title lang="en">Debug overlay</title></meta>
        </property>

        <property name="startOffset" type="number" colspan="4">
            <meta><title lang="en">Start offset (%)</title></meta>
            <params>
                <param name="min" value="0"/>
                <param name="max" value="110"/>
            </params>
        </property>
        <property name="endOffset" type="number" colspan="4">
            <meta><title lang="en">End offset (%)</title></meta>
            <params>
                <param name="min" value="0"/>
                <param name="max" value="110"/>
            </params>
        </property>
    </properties>

</template>
