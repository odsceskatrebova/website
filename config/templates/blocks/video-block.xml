<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>video-block</key>

    <meta>
        <title lang="en">Video block</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="3">
            <meta>
                <title lang="en">sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="3">
            <meta><title lang="en">id</title></meta>
        </property>
        <property name="classes" type="text_line" colspan="6">
            <meta>
                <title lang="en">classes</title>
            </meta>
        </property>

        <property name="backgroundVideo" type="single_media_selection" colspan="6">
            <meta><title lang="en">video phone</title></meta>
        </property>
        <property name="backgroundVideoTablet" type="single_media_selection" colspan="6">
            <meta><title lang="en">video tablet +</title></meta>
        </property>

        <property name="width" type="text_line" colspan="3">
            <meta><title lang="en">width (specify unit)</title></meta>
        </property>
        <property name="height" type="text_line" colspan="3">
            <meta><title lang="en">height (specify unit)</title></meta>
        </property>
        <property name="maxWidth" type="text_line" colspan="3">
            <meta><title lang="en">max width (specify unit)</title></meta>
        </property>
        <property name="maxHeight" type="text_line" colspan="3">
            <meta><title lang="en">max height (specify unit)</title></meta>
        </property>

        <property name="aspectRatio" type="number" colspan="3">
            <meta>
                <title lang="en">aspect ratio</title>
            </meta>
            <params>
                <param name="min" value=".2"/>
                <param name="max" value="5"/>
            </params>
        </property>
        <property name="placement" type="single_select" colspan="3">
            <meta>
                <title lang="en">placement</title>
            </meta>
            <params>
                <param name="default_value" value="contain"/>
                <param name="values" type="collection">
                    <param name="contain"><meta><title lang="en">contain</title></meta></param>
                    <param name="cover"><meta><title lang="en">cover</title></meta></param>
                </param>
            </params>
        </property>
        <property name="playback" type="single_select" colspan="3">
            <meta>
                <title lang="en">playback</title>
            </meta>
            <params>
                <param name="default_value" value="paused"/>
                <param name="values" type="collection">
                    <param name="paused"><meta><title lang="en">Paused</title></meta></param>
                    <param name="playOnce"><meta><title lang="en">Play once</title></meta></param>
                    <param name="loop"><meta><title lang="en">Loop</title></meta></param>
                    <param name="sectionLoop"><meta><title lang="en">Section loop</title></meta></param>
                </param>
            </params>
        </property>
        <property name="delayBetweenLoops" type="number" colspan="3">
            <meta>
                <title lang="en">delay between loops [s]</title>
            </meta>
            <params>
                <param name="min" value="0"/>
                <param name="max" value="100"/>
            </params>
        </property>

        <property name="showUi" type="checkbox" colspan="2">
            <meta>
                <title lang="en">show UI</title>
            </meta>
            <params>
                <param name="default_value" value="true"/>
                <param name="type" value="toggler"/>
            </params>
        </property>
    </properties>

</template>
