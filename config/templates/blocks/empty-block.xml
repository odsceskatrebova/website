<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>empty-block</key>

    <meta>
        <title lang="en">Empty block</title>
    </meta>

    <properties>
        <property name="aspectRatio" type="number" colspan="4">
            <meta>
                <title lang="en">aspect ratio</title>
            </meta>
            <params>
                <param name="min" value=".2"/>
                <param name="max" value="5"/>
            </params>
        </property>
        <property name="aspectRatioTablet" type="number" colspan="4">
            <meta>
                <title lang="en">aspect ratio tablet</title>
            </meta>
            <params>
                <param name="min" value=".2"/>
                <param name="max" value="5"/>
            </params>
        </property>
        <property name="aspectRatioDesktop" type="number" colspan="4">
            <meta>
                <title lang="en">aspect ratio desktop</title>
            </meta>
            <params>
                <param name="min" value=".2"/>
                <param name="max" value="5"/>
            </params>
        </property>
    </properties>

</template>
