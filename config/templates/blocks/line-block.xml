<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>line-block</key>

    <meta>
        <title lang="en">Line</title>
    </meta>

    <properties>
        <property name="lineColor" type="single_select" colspan="3">
            <meta><title lang="en">Colour</title></meta>
            <tag name="sulu.block_preview" priority="512"/>
            <params>
                <param name="default_value" value="border"/>
                <param name="values" type="collection">
                    <param name="brand"><meta><title lang="en">Brand</title></meta></param>
                    <param name="indigo"><meta><title lang="en">Indigo</title></meta></param>
                    <param name="border"><meta><title lang="en">Hairline</title></meta></param>
                    <param name="ink"><meta><title lang="en">Ink</title></meta></param>
                    <param name="white"><meta><title lang="en">White</title></meta></param>
                </param>
            </params>
        </property>
        <property name="thickness" type="text_line" colspan="3"><meta><title lang="en">thickness (e.g. 2px)</title></meta></property>
        <property name="length" type="text_line" colspan="3"><meta><title lang="en">length (e.g. 30%)</title></meta></property>
        <property name="angle" type="text_line" colspan="3"><meta><title lang="en">angle (e.g. -3deg)</title></meta></property>
        <property name="top" type="text_line" colspan="3"><meta><title lang="en">top</title></meta></property>
        <property name="left" type="text_line" colspan="3"><meta><title lang="en">left</title></meta></property>
        <property name="right" type="text_line" colspan="3"><meta><title lang="en">right</title></meta></property>
        <property name="bottom" type="text_line" colspan="3"><meta><title lang="en">bottom</title></meta></property>
        <property name="depth" type="text_line" colspan="3">
            <meta><title lang="en">parallax depth (0–1, blank = none)</title></meta>
        </property>
    </properties>

</template>
