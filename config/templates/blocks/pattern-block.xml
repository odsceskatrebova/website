<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>pattern-block</key>

    <meta>
        <title lang="en">Pattern</title>
    </meta>

    <properties>
        <!-- The tile image is used as a MASK: only its alpha shape matters,
             the colour comes from patternColor (+ opacity / blur). -->
        <property name="image" type="single_media_selection" colspan="6">
            <meta>
                <title lang="en">Tile image (alpha = pattern shape)</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="patternColor" type="single_select" colspan="3">
            <meta><title lang="en">Colour</title></meta>
            <params>
                <param name="default_value" value="brand"/>
                <param name="values" type="collection">
                    <param name="brand"><meta><title lang="en">Brand</title></meta></param>
                    <param name="brandDeep"><meta><title lang="en">Brand deep</title></meta></param>
                    <param name="indigo"><meta><title lang="en">Indigo</title></meta></param>
                    <param name="navy"><meta><title lang="en">Navy</title></meta></param>
                    <param name="navyDeep"><meta><title lang="en">Navy deep</title></meta></param>
                    <param name="green"><meta><title lang="en">Green</title></meta></param>
                    <param name="greenForest"><meta><title lang="en">Green forest</title></meta></param>
                    <param name="ink"><meta><title lang="en">Ink</title></meta></param>
                    <param name="border"><meta><title lang="en">Grey border</title></meta></param>
                    <param name="soft"><meta><title lang="en">Soft grey</title></meta></param>
                    <param name="frost"><meta><title lang="en">Frost</title></meta></param>
                    <param name="white"><meta><title lang="en">White</title></meta></param>
                </param>
            </params>
        </property>
        <property name="blur" type="text_line" colspan="3"><meta><title lang="en">backdrop blur (e.g. 6px)</title></meta></property>
        <property name="tileWidth" type="text_line" colspan="3"><meta><title lang="en">tile width (e.g. 8rem)</title></meta></property>
        <property name="tileHeight" type="text_line" colspan="3"><meta><title lang="en">tile height (e.g. 8rem)</title></meta></property>
        <property name="fillOpacity" type="text_line" colspan="3"><meta><title lang="en">colour fill opacity (0–1)</title></meta></property>
        <property name="opacity" type="text_line" colspan="3"><meta><title lang="en">element opacity (0–1)</title></meta></property>
        <property name="depth" type="text_line" colspan="3"><meta><title lang="en">parallax depth (0–1)</title></meta></property>

        <!-- Leave the box empty for FULL cover. Set any of top/left/right/bottom/
             width/height to make it a PARTIAL box. -->
        <property name="top" type="text_line" colspan="2"><meta><title lang="en">top</title></meta></property>
        <property name="left" type="text_line" colspan="2"><meta><title lang="en">left</title></meta></property>
        <property name="right" type="text_line" colspan="2"><meta><title lang="en">right</title></meta></property>
        <property name="bottom" type="text_line" colspan="2"><meta><title lang="en">bottom</title></meta></property>
        <property name="width" type="text_line" colspan="2"><meta><title lang="en">width</title></meta></property>
        <property name="height" type="text_line" colspan="2"><meta><title lang="en">height</title></meta></property>
    </properties>

</template>
