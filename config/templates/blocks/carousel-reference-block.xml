<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>carousel-reference-block</key>

    <meta>
        <title lang="en">Reference carousel</title>
    </meta>

    <properties>
        <property name="sulu-display-name" type="text_line" colspan="3">
            <meta>
                <title lang="en">sulu display name</title>
            </meta>
            <tag name="sulu.block_preview" priority="512"/>
        </property>
        <property name="id" type="text_line" colspan="3">
            <meta><title lang="en">id</title></meta>
        </property>
        <property name="classes" type="text_line" colspan="6">
            <meta>
                <title lang="en">classes</title>
            </meta>
        </property>

        <block name="references" default-type="reference">
            <meta>
                <title lang="en">References</title>
            </meta>
            <params>
                <param name="add_button_text">
                    <meta>
                        <title lang="en">Add reference</title>
                    </meta>
                </param>
                <param name="block_id_generator" value="true"/>
            </params>
            <types>
                <type name="reference">
                    <meta>
                        <title lang="en">Reference</title>
                    </meta>
                    <properties>
                        <property name="text" type="text_editor">
                            <meta><title lang="en">text</title></meta>
                            <tag name="sulu.block_preview" priority="1024"/>
                            <tag name="sulu.search.field" />
                        </property>
                        <property name="name" type="text_line" colspan="3">
                            <meta><title lang="en">name</title></meta>
                            <tag name="sulu.block_preview" priority="512"/>
                            <tag name="sulu.search.field" />
                        </property>
                        <property name="about" type="text_line" colspan="3">
                            <meta><title lang="en">about</title></meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>

    </properties>

</template>
