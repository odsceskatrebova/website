<?xml version="1.0" encoding="utf-8"?>
<webspace xmlns="http://schemas.sulu.io/webspace/webspace"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/webspace/webspace http://schemas.sulu.io/webspace/webspace-1.1.xsd">

    <name>Odsct</name>
    <key>odsct</key>

    <localizations>
        <localization language="cs" default="true"/>
    </localizations>

    <default-templates>
        <default-template type="page">default</default-template>
        <default-template type="home">default</default-template>
    </default-templates>

    <!-- <excluded-templates>
        <excluded-template>other</excluded-template>
    </excluded-templates> -->

    <templates>
        <template type="search">search/search</template>
        <template type="error">error/error</template>
    </templates>

    <navigation>
        <contexts>
            <context key="header">
                <meta>
                    <title lang="en">Header</title>
                    <title lang="cs">Hlavička</title>
                </meta>
            </context>
        </contexts>
    </navigation>

    <portals>
        <portal>
            <name>Odsct</name>
            <key>odsct</key>

            <environments>
                <environment type="prod">
                    <urls>
                        <url language="cs">{host}</url>
                    </urls>
                </environment>
                <environment type="stage">
                    <urls>
                        <url language="cs">{host}</url>
                    </urls>
                </environment>
                <environment type="dev">
                    <urls>
                        <url language="cs">odsct.local</url>
                    </urls>
                </environment>
            </environments>
        </portal>
    </portals>
</webspace>
