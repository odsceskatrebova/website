<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: sans-serif; color: #333; }
    </style>
</head>
<body>
<table style="width:100%">
    <tr>
        <td>&nbsp;</td>
        <td style="max-width:600px">
            <main>
                {% block content %}{% endblock %}
            </main>
            <footer style="border-top:1px solid #333; padding-top:1rem; margin-top:2rem; font-size:.85rem">
                {% block footer %}
                    <p>{{ 'footer.paragraph'|trans({}, 'email', lang) }}</p>
                    <p>
                        {{ 'footer.greetings.line1'|trans({}, 'email', lang) }}<br>
                        {{ 'footer.greetings.line2'|trans({}, 'email', lang) }}
                    </p>
                {% endblock %}
            </footer>
        </td>
        <td>&nbsp;</td>
    </tr>
</table>
</body>
</html>
