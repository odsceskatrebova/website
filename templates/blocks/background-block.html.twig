{% set styles = [] %}
{% set contentStyles = [] %}
{% if data.contentAspectRatio %}
  {% set contentStyles = styles|merge(['aspect-ratio: ' ~ data.contentAspectRatio]) %}
{% endif %}

{% set containerImage = false %}

<div id="{{ data.id }}"
  class="background-block {{ data.classes }} {{ data.hero ? 'hero' : '' }} {{ data.darkSection ? 'dark-section' : '' }}"
  style="{{ styles | join('; ') }}"
  {{ sulu_block_preview(data) }}
>
  {% for element in data.background | reverse() %}
    {% set randomId = random() %}
    {% if element.type == 'image-block' and element.image !=null %}

      <div class="background-image{{ element.depth ? ' parallax' : '' }}" id="image-block-{{ randomId }}"{{ element.depth ? ' style="--depth: ' ~ element.depth ~ '"' : '' }}>
        <picture>
          {% if 'svg' in element.image.fileVersion.mimeType %}
            <img
              src="{{ element.image.thumbnails['full'] }}"
              alt="{{ element.image.title }}"
            >
          {% else %}
            {% if element.imageDesktop %}
              <source
                srcset="{{ element.imageDesktop.thumbnails['full-page.webp'] }}, {{ element.imageDesktop.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
              >
              <source
                srcset="{{ element.imageDesktop.thumbnails['full-desktop.webp'] }}, {{ element.imageDesktop.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
              >
            {% elseif element.imageTablet %}
              <source
                srcset="{{ element.imageTablet.thumbnails['full-page.webp'] }}, {{ element.imageTablet.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
              >
              <source
                srcset="{{ element.imageTablet.thumbnails['full-desktop.webp'] }}, {{ element.imageTablet.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
              >
            {% else %}
              <source
                srcset="{{ element.image.thumbnails['full-page.webp'] }}, {{ element.image.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
              >
              <source
                srcset="{{ element.image.thumbnails['full-desktop.webp'] }}, {{ element.image.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
              >
            {% endif %}
            {% if element.imageTablet %}
              <source
                srcset="{{ element.imageTablet.thumbnails['full-tablet.webp'] }}, {{ element.imageTablet.thumbnails['full-tablet@2x.webp'] }} 2x"
                media="(min-width: 55rem)"
              >
            {% else %}
              <source
                srcset="{{ element.image.thumbnails['full-tablet.webp'] }}, {{ element.image.thumbnails['full-tablet@2x.webp'] }} 2x"
                media="(min-width: 55rem)"
              >
            {% endif %}
            {% if element.image %}
              <img
                srcset="{{ element.image.thumbnails['full.webp'] }}, {{ element.image.thumbnails['full@2x.webp'] }} 2x"
                alt="{{ element.image.title }}"
              >
            {% endif %}
          {% endif %}
        </picture>
      </div>
      <style>
          #image-block-{{ randomId }} {
          {% if element.top %}
              top: {{ element.top }};
          {% endif %}
          {% if element.height %}
              height: {{ element.height }};
          {% endif %}
              picture {
              {% if element.left %}
                  left: {{ element.left }};
              {% endif %}
              {% if element.width %}
                  width: {{ element.width }};
              {% endif %}
              {% if element.height %}
                  height: {{ element.height }};
              {% endif %}
              {% if element.aspectRatio %}
                  aspect-ratio: {{ element.aspectRatio }};
              {% endif %}
                  img {
                  {% if element.fit %}
                      object-fit: {{ element.fit }};
                  {% endif %}
                  }
              }
          }
          @media (min-width: 55rem) {
              #image-block-{{ randomId }} {
              {% if element.topTablet %}
                  top: {{ element.topTablet }};
              {% endif %}
              {% if element.heightTablet %}
                  height: {{ element.heightTablet }};
              {% endif %}
                  picture {
                  {% if element.aspectRatioTablet %}
                      aspect-ratio: {{ element.aspectRatioTablet }};
                  {% endif %}
                  {% if element.leftTablet %}
                      left: {{ element.leftTablet }};
                  {% endif %}
                  {% if element.widthTablet %}
                      width: {{ element.widthTablet }};
                  {% endif %}
                  {% if element.heightTablet %}
                      height: {{ element.heightTablet }};
                  {% endif %}
                      img {
                      {% if element.fitTablet %}
                          object-fit: {{ element.fitTablet }};
                      {% endif %}
                      }

                  }
              }
          }
          @media (min-width: 73rem) {
              #image-block-{{ randomId }} {
              {% if element.topDesktop %}
                  top: {{ element.topDesktop }};
              {% endif %}
              {% if element.heightDesktop %}
                  height: {{ element.heightDesktop }};
              {% endif %}
                  picture {
                  {% if element.aspectRatioDesktop %}
                      aspect-ratio: {{ element.aspectRatioDesktop }};
                  {% endif %}
                  {% if element.leftDesktop %}
                      left: {{ element.leftDesktop }};
                  {% endif %}
                  {% if element.widthDesktop %}
                      width: {{ element.widthDesktop }};
                  {% endif %}
                  {% if element.heightDesktop %}
                      height: {{ element.heightDesktop }};
                  {% endif %}
                      img {
                      {% if element.fitDesktop %}
                          object-fit: {{ element.fitDesktop }};
                      {% endif %}
                      }
                  }
              }
          }
      </style>
    {% elseif element.type == 'container-image-block' and element.image !=null %}
      {% set containerImage = true %}
      <div class="background-image container-width" id="image-block-{{ randomId }}">
      <picture class="background-image" id="image-block-{{ randomId }}">
        {% if 'svg' in element.image.fileVersion.mimeType %}
              <img
                src="{{ element.image.thumbnails['full'] }}"
                alt="{{ element.image.title }}"
              >
          {% else %}
            {% if element.imageDesktop %}
                <source
                srcset="{{ element.imageDesktop.thumbnails['full-page.webp'] }}, {{ element.imageDesktop.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
                >
                <source
                srcset="{{ element.imageDesktop.thumbnails['full-desktop.webp'] }}, {{ element.imageDesktop.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
                >
            {% elseif element.imageTablet %}
              <source
                srcset="{{ element.imageTablet.thumbnails['full-page.webp'] }}, {{ element.imageTablet.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
                >
                <source
                srcset="{{ element.imageTablet.thumbnails['full-desktop.webp'] }}, {{ element.imageTablet.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
                >
            {% else %}
              <source
                srcset="{{ element.image.thumbnails['full-page.webp'] }}, {{ element.image.thumbnails['full-page@2x.webp'] }} 2x"
                media="(min-width: 120rem)"
                >
                <source
                srcset="{{ element.image.thumbnails['full-desktop.webp'] }}, {{ element.image.thumbnails['full-desktop@2x.webp'] }} 2x"
                media="(min-width: 73rem)"
                >
            {% endif %}
            {% if element.imageTablet %}
                <source
                srcset="{{ element.imageTablet.thumbnails['full-tablet.webp'] }}, {{ element.imageTablet.thumbnails['full-tablet@2x.webp'] }} 2x"
                media="(min-width: 55rem)"
                >
            {% else %}
                <source
                srcset="{{ element.image.thumbnails['full-tablet.webp'] }}, {{ element.image.thumbnails['full-tablet@2x.webp'] }} 2x"
                media="(min-width: 55rem)"
                >
            {% endif %}
            {% if element.image %}
                <img
                srcset="{{ element.image.thumbnails['full.webp'] }}, {{ element.image.thumbnails['full@2x.webp'] }} 2x"
                alt="{{ element.image.title }}"
            >
            {% endif %}
          {% endif %}
      </picture>
      </div>
      <style>
          #image-block-{{ randomId }} img {
          {% if element.fit %}
              object-fit: {{ element.fit }};
          {% endif %}
          }
          @media (min-width: 55rem) {
              #image-block-{{ randomId }} img {
              {% if element.fitTablet %}
                  object-fit: {{ element.fitTablet }};
              {% endif %}
              }
          }
          @media (min-width: 73rem) {
              #image-block-{{ randomId }} img {
              {% if element.fitDesktop %}
                  object-fit: {{ element.fitDesktop }};
              {% endif %}
              }
          }
      </style>
    {% elseif element.type == 'color-block' %}
      {% set s = [] %}
      {% if element.radius %}{% set s = s|merge(['--fill-radius: ' ~ element.radius]) %}{% endif %}
      {% set hasBox = element.top or element.left or element.right or element.bottom or element.width or element.height %}
      {% if hasBox %}
        {% if element.top %}{% set s = s|merge(['top: ' ~ element.top]) %}{% endif %}
        {% if element.left %}{% set s = s|merge(['left: ' ~ element.left]) %}{% endif %}
        {% if element.right %}{% set s = s|merge(['right: ' ~ element.right]) %}{% endif %}
        {% if element.bottom %}{% set s = s|merge(['bottom: ' ~ element.bottom]) %}{% endif %}
        {% if element.width %}{% set s = s|merge(['width: ' ~ element.width]) %}{% endif %}
        {% if element.height %}{% set s = s|merge(['height: ' ~ element.height]) %}{% endif %}
      {% endif %}
      {% if element.depth %}{% set s = s|merge(['--depth: ' ~ element.depth]) %}{% endif %}
      <div class="color-block fill-{{ element.fill|default('navy') }}{{ hasBox ? ' is-partial' : '' }}{{ element.depth ? ' parallax' : '' }}"
           aria-hidden="true" style="{{ s|join('; ') }}">
        {% for glow in element.glows|default([]) %}
          {% include 'blocks/_glow.html.twig' with { glow: glow, cropped: true } only %}
        {% endfor %}
      </div>

    {% elseif element.type == 'glow-block' %}
      {% include 'blocks/_glow.html.twig' with { glow: element, cropped: false } only %}

    {% elseif element.type == 'line-block' %}
      {% set s = [] %}
      {% if element.top %}{% set s = s|merge(['top: ' ~ element.top]) %}{% endif %}
      {% if element.left %}{% set s = s|merge(['left: ' ~ element.left]) %}{% endif %}
      {% if element.right %}{% set s = s|merge(['right: ' ~ element.right]) %}{% endif %}
      {% if element.bottom %}{% set s = s|merge(['bottom: ' ~ element.bottom]) %}{% endif %}
      {% if element.thickness %}{% set s = s|merge(['--line-thickness: ' ~ element.thickness]) %}{% endif %}
      {% if element.length %}{% set s = s|merge(['--line-length: ' ~ element.length]) %}{% endif %}
      {% if element.angle %}{% set s = s|merge(['--line-angle: ' ~ element.angle]) %}{% endif %}
      {% if element.depth %}{% set s = s|merge(['--depth: ' ~ element.depth]) %}{% endif %}
      <div class="line-block line-{{ element.lineColor|default('border') }}{{ element.depth ? ' parallax' : '' }}"
           aria-hidden="true" style="{{ s|join('; ') }}"></div>

    {% elseif element.type == 'stripes-block' %}
      {% include 'blocks/_stripes.html.twig' with { stripes: element } only %}
    {% endif %}
  {% endfor %}
  <div
    class="wrapper-content container {{ data.contentClasses }}"
    style="{{ contentStyles | join('; ') }}"
  >

    {% if containerImage %}
      <div class="container">
    {% endif %}
        {% for placement, block in data.content %}
          {% set blockView = dataView.content[placement] %}
          {% if block.type == 'grid-block' %}
            {% include 'blocks/grid-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'flex-block' %}
            {% include 'blocks/flex-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'text-block' %}
            {% include 'blocks/text-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'button-block' %}
            {% include 'blocks/button-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'image-block' %}
            {% include 'blocks/image-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'divider-block' %}
            {% include 'blocks/divider-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'empty-block' %}
            {% include 'blocks/empty-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'carousel-reference-block' %}
            {% include 'blocks/carousel-reference-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% elseif block.type == 'card-block' %}
            {% include 'blocks/card-block.html.twig' with { data: block, dataView: blockView, placement: placement } %}
          {% else %}
            <div class="error-box">missing block: {{ block.type }}</div>
          {% endif %}
        {% endfor %}
    {% if containerImage %}
      </div>
    {% endif %}
  </div>
</div>
