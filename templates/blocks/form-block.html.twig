<div id="{{ data.id }}" class="form {{ data.classes }}" {{ sulu_block_preview(data) }}>
  {% if data.formTemplate is null %}
    <div class="error-box">
      missing form template
    </div>
  {% else %}
    {% set templateUUID = dataView.formTemplate.id is defined ? dataView.formTemplate.id : null %}
    {% set formTemplate = data.formTemplate | merge({ 'uuid': templateUUID }) %}
    {%  if config is defined and config != null %}
      {% set formTemplate = formTemplate | merge({ 'gdprLink': config.gdprLink }) %}
    {% endif %}
    {% set data = data | merge({ 'formTemplate': formTemplate })  %}

    <div class="vue-form-block">
      <div class="loader"></div>
      <pre class="config">
        {{ data | json_encode | raw }}
      </pre>
    </div>
  {% endif %}
</div>
