{#
  Renders one repeating-pattern element. Params:
    pattern — block data (image, patternColor, blur, tileWidth, tileHeight,
              fillOpacity, opacity, top/left/right/bottom/width/height, depth)
    cropped — bool; when true (inside a card) the parallax class is
              suppressed, same rule as _glow.html.twig.
  The tile image is used as a MASK — colour, fill opacity, backdrop blur and
  the tiling itself live in assets/common/styles/components/pattern.scss.
#}
{% set s = [] %}
{% if pattern.top %}{% set s = s|merge(['top: ' ~ pattern.top]) %}{% endif %}
{% if pattern.left %}{% set s = s|merge(['left: ' ~ pattern.left]) %}{% endif %}
{% if pattern.right %}{% set s = s|merge(['right: ' ~ pattern.right]) %}{% endif %}
{% if pattern.bottom %}{% set s = s|merge(['bottom: ' ~ pattern.bottom]) %}{% endif %}
{% if pattern.width %}{% set s = s|merge(['width: ' ~ pattern.width]) %}{% endif %}
{% if pattern.height %}{% set s = s|merge(['height: ' ~ pattern.height]) %}{% endif %}
{% if pattern.image %}{% set s = s|merge(["--pattern-image: url('" ~ pattern.image.thumbnails['full'] ~ "')"]) %}{% endif %}
{% if pattern.tileWidth %}{% set s = s|merge(['--pattern-w: ' ~ pattern.tileWidth]) %}{% endif %}
{% if pattern.tileHeight %}{% set s = s|merge(['--pattern-h: ' ~ pattern.tileHeight]) %}{% endif %}
{% if pattern.fillOpacity %}{% set s = s|merge(['--pattern-fill-opacity: ' ~ pattern.fillOpacity]) %}{% endif %}
{% if pattern.opacity %}{% set s = s|merge(['--pattern-opacity: ' ~ pattern.opacity]) %}{% endif %}
{% if pattern.blur %}{% set s = s|merge(['--pattern-blur: ' ~ pattern.blur]) %}{% endif %}
{% set parallax = (cropped is not defined or not cropped) and pattern.depth %}
{% if parallax %}{% set s = s|merge(['--depth: ' ~ pattern.depth]) %}{% endif %}
<div class="pattern-block pattern-{{ pattern.patternColor|default('brand') }}{{ pattern.blur ? ' has-blur' : '' }}{{ parallax ? ' parallax' : '' }}" aria-hidden="true" style="{{ s|join('; ') }}"></div>
