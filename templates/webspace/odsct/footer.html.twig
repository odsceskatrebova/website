{# odsct campaign footer — wired to the websiteConfig snippet (principles, brand,
   quick/elsewhere links, contact, closing group photo) plus a slim legal row.
   Bespoke to the odsct webspace (see design/ODS Web odsct.cz). Replaces the
   generic layout/footer.html.twig here; wired from webspace/odsct.html.twig. #}
{% set dateRange = election_date_range(config.electionDateStart, config.electionDateEnd) %}
{% set brandSub = config.electionLabel %}
{% if config.electionLabel and dateRange %}
    {% set brandSub = config.electionLabel ~ ' · ' ~ dateRange %}
{% elseif dateRange %}
    {% set brandSub = dateRange %}
{% endif %}
<footer class="site-footer">
    <div class="site-footer__glow" aria-hidden="true"></div>

    <div class="site-footer__principles container">
        <div class="site-footer__principles-grid">
            {% for point in config.valuePoints %}
                <div class="site-footer__principle">
                    <div class="site-footer__principle-title">{{ point.pointTitle }}</div>
                    <div class="site-footer__principle-text">{{ point.pointText }}</div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="site-footer__main container">
        <div class="site-footer__brand">
            <span class="site-footer__badge">{{ config.badgeText }}</span>
            {% if brandSub %}
                <div class="site-footer__brand-sub">{{ brandSub }}</div>
            {% endif %}
            {% if config.brandDescription %}
                <div class="site-footer__brand-desc">{{ config.brandDescription|nl2br }}</div>
            {% endif %}
        </div>

        <div class="site-footer__links">
            {% if config.footerQuickLinks %}
                <div class="site-footer__links-label">RYCHLÉ ODKAZY</div>
                {% for item in config.footerQuickLinks %}
                    <a class="site-footer__link" href="{{ item.link }}">{{ item.text }}{% if item.highlightText %}<span>{{ item.highlightText }}</span>{% endif %}</a>
                {% endfor %}
            {% endif %}
            {% if config.footerElsewhereLinks %}
                <div class="site-footer__links-label{% if config.footerQuickLinks %} site-footer__links-label--spaced{% endif %}">JINDE</div>
                {% for item in config.footerElsewhereLinks %}
                    <a class="site-footer__link" href="{{ item.link }}">{{ item.text }}{% if item.highlightText %}<span>{{ item.highlightText }}</span>{% endif %}</a>
                {% endfor %}
            {% endif %}
        </div>

        <div class="site-footer__contact">
            <div class="site-footer__contact-label">KONTAKT</div>
            {% if config.contactEmail %}
                <a class="site-footer__contact-line" href="mailto:{{ config.contactEmail }}">{{ config.contactEmail }}</a>
            {% endif %}
            {% if config.contactPhone %}
                <a class="site-footer__contact-line" href="tel:{{ config.contactPhone|replace({' ': ''}) }}">{{ config.contactPhone }}</a>
            {% endif %}
            {% if config.footerQuote %}
                <div class="site-footer__handwritten">{{ config.footerQuote }}</div>
            {% endif %}
        </div>
    </div>

    {% if config.footerPicture %}
        <div class="site-footer__photo container">
            <div class="site-footer__photo-inner">
                <picture>
                    <source
                        srcset="{{ config.footerPicture.thumbnails['full-page.webp'] }}, {{ config.footerPicture.thumbnails['full-page@2x.webp'] }} 2x"
                        media="(min-width: 120rem)"
                    >
                    <source
                        srcset="{{ config.footerPicture.thumbnails['full-desktop.webp'] }}, {{ config.footerPicture.thumbnails['full-desktop@2x.webp'] }} 2x"
                        media="(min-width: 73rem)"
                    >
                    <source
                        srcset="{{ config.footerPicture.thumbnails['full-tablet.webp'] }}, {{ config.footerPicture.thumbnails['full-tablet@2x.webp'] }} 2x"
                        media="(min-width: 55rem)"
                    >
                    <img
                        class="site-footer__photo-img"
                        srcset="{{ config.footerPicture.thumbnails['full.webp'] }}, {{ config.footerPicture.thumbnails['full@2x.webp'] }} 2x"
                        alt="{{ config.footerPicture.title }}"
                    >
                </picture>
            </div>
        </div>
    {% endif %}

    <div class="site-footer__legal container">
        {% if config.copyrightText %}
            <p class="site-footer__legal-copyright">{{ config.copyrightText|replace({'%Y%': 'now'|date('Y')}) }}</p>
        {% endif %}
        <div class="site-footer__legal-links">
            {% if config.gdprLink %}
                <a class="site-footer__legal-link" href="{{ config.gdprLink }}">Ochrana osobních údajů</a>
            {% endif %}
            <a class="site-footer__legal-link" href="#" data-cookie-settings-trigger>{{ 'cookieSettings.openLink'|trans }}</a>
        </div>
    </div>
</footer>
