            <span class="site-header__tagline">KOMUNÁLNÍ VOLBY<br>25.–26.&nbsp;9.&nbsp;2026 · ČESKÁ TŘEBOVÁ</span>
        </a>
        <nav class="site-header__nav">
            <a href="#program" class="site-header__link">Program</a>
            <a href="#bilance" class="site-header__link">Zúčtování</a>
            <a href="#tym" class="site-header__link">Tým</a>
            <a href="#dira" class="site-header__link">Vyfoť díru</a>
            <a href="#volit" class="site-header__cta">Přijďte volit</a>
        </nav>
    </div>
</header>
