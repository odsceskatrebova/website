{% extends 'base.html.twig' %}

{# Renders inside the shared odsct header/footer chrome (base.html.twig ->
   webspace/odsct.html.twig), so it must not depend on any websiteConfig field
   beyond what that chrome already handles — error pages must render even with
   an empty config. #}
{% block content %}
    <section class="error-page">
        <div class="error-page__inner container">
            <span class="error-page__code">{{ status_code }}</span>
            {% if status_code == 404 %}
                <h1 class="error-page__title">Tahle stránka tu není. Jako ta lávka u nádraží.</h1>
                <p class="error-page__text">Zkuste to z hlavní stránky.</p>
            {% else %}
                <h1 class="error-page__title">Něco se pokazilo. Pracujeme na tom.</h1>
            {% endif %}
            <a class="error-page__cta" href="/{{ app.request.locale }}">Zpět na hlavní stránku</a>
        </div>
    </section>
{% endblock %}
